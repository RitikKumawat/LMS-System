# ================================
# DATABASE
# ================================
DATABASE_URL=mongodb://localhost:27017/lms_database

# ================================
# SERVER
# ================================
PORT=4000
BASE_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# ================================
# JWT AUTHENTICATION
# ================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ================================
# GRAPHQL
# ================================
PLAYGROUND=true

# ================================
# REDIS (Required for certificate generation)
# ================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ================================
# EMAIL (Required for certificate notifications)
# ================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password-16-characters
MAIL_FROM="LMS Platform <no-reply@yourdomain.com>"

# ================================
# PAYMENT (Optional)
# ================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ================================
# FILE UPLOADS
# ================================
MAX_FILE_SIZE=104857600  # 100MB in bytes

# ================================
# ENVIRONMENT
# ================================
NODE_ENV=development
